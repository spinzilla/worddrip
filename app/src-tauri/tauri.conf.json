{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "english-studio",
  "version": "0.11.4",
  "identifier": "com.englishstudio.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "词滴 WordDrip",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 32
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' asset: http://asset.localhost data: https: http:; media-src 'self' asset: http://asset.localhost blob:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'; form-action 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRBOEEzNEY2MTYwQUJBQUUKUldTdXVnb1c5alNLU3VvSEVoeUFFTzRGYXJ0ek5BMlZhUjIvK2licGhFUW5mTmd2UkIxdmhZaWYK",
      "endpoints": [
        "https://vocab.uestceee.art/worddrip-updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "resources": {
      "resources/wordpack/wordpack.json.gz": "wordpack/wordpack.json.gz",
      "resources/wordpack/LICENSE-DATA.md": "wordpack/LICENSE-DATA.md"
    },
    "targets": [
      "dmg",
      "app"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
